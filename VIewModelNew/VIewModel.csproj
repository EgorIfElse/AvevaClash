<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
	<LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x86</PlatformTarget>
    <CompanyReferencesPath Condition="'$(CompanyReferencesPath)' == '' and Exists('\\KPEI-MSK-HQ-AVEVA-FS01\Share\AVEVA\AVEVADLL\CLS')">\\KPEI-MSK-HQ-AVEVA-FS01\Share\AVEVA\AVEVADLL\CLS</CompanyReferencesPath>
    <CompanyReferencesPath Condition="'$(CompanyReferencesPath)' == ''">$(MSBuildThisFileDirectory)..\References</CompanyReferencesPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aveva.ClashChecker.NetCallable\Aveva.ClashChecker.NetCallable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Aveva.Core">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core.dll</HintPath>
    </Reference>
    <Reference Include="Aveva.Core.Database">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core.Database.dll</HintPath>
    </Reference>
    <Reference Include="Aveva.Core.Database.Filters">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core.Database.Filters.dll</HintPath>
    </Reference>
    <Reference Include="Aveva.Core.Geometry">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core.Geometry.dll</HintPath>
    </Reference>
    <Reference Include="Aveva.Core.Utilities">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core.Utilities.dll</HintPath>
    </Reference>
    <Reference Include="Aveva.Core3D.Clasher">
      <HintPath>$(CompanyReferencesPath)\Aveva.Core3D.Clasher.dll</HintPath>
    </Reference>
    <Reference Include="DataGridExtensions">
      <HintPath>$(CompanyReferencesPath)\DataGridExtensions.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="PMLNet">
      <HintPath>$(CompanyReferencesPath)\PMLNet.dll</HintPath>
    </Reference>
    <Reference Include="PMLNetUtilities">
      <HintPath>$(CompanyReferencesPath)\PMLNetUtilities.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsFormsIntegration" />
  </ItemGroup>


</Project>
