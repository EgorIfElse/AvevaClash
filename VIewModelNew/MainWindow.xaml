<Window x:Class="ViewForm.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Проверка на коллизии"
        Height="720"
        Width="1500"
        MinHeight="600"
        MinWidth="1200"
        Background="#F7F8FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Центровка текста в таблице -->
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Заголовки таблицы -->
        <Style x:Key="BaseColumnHeaderStyle" TargetType="DataGridColumnHeader">

            <Setter Property="Foreground" Value="#2F343B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Разделитель между группами элементов коллизии -->
        <Style x:Key="GroupEndHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource BaseColumnHeaderStyle}">
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="GroupEndCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- Прогрессбар карточек -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#ECEFF3"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>

                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Синяя кнопка -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обычная нижняя кнопка -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>


            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Переключатель дополнительных столбцов -->
        <Style x:Key="SwitchToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="44" Height="24">
                            <Border x:Name="Track"
                                    Background="#D1D5DB"
                                    CornerRadius="12"/>
                            <Ellipse x:Name="Thumb"
                                     Width="20"
                                     Height="20"
                                     Margin="2"
                                     Fill="White"
                                     HorizontalAlignment="Left"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track"
                                        Property="Background"
                                        Value="#3B82F6"/>
                                <Setter TargetName="Thumb"
                                        Property="HorizontalAlignment"
                                        Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track"
                                        Property="Opacity"
                                        Value="0.45"/>
                                <Setter TargetName="Thumb"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ВЕРХНЯЯ ПАНЕЛЬ ================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- ComboBox с иконкой -->
                <Border Grid.Column="0"
                        Grid.ColumnSpan="2"
                        CornerRadius="8"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="#3B82F6"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                        <ComboBox x:Name="CbZone"
                                  Grid.Column="1"
                                  Height="34"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="ZoneElement"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Padding="0,4,8,4"
                                  FontWeight="SemiBold"
                                  Foreground="#64748B"
                                  SelectionChanged="CbZone_SelectionChanged"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Обновить -->
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="36"
                        MinWidth="36"
                        Padding="0"
                        Margin="10,0,17,0"
                        ToolTip="Обновить"
                        Click="BtnRefresh_Click">
                    <materialDesign:PackIcon Kind="RefreshCircle"
                                             Width="18"
                                             Height="18"
                                             Foreground="#3B82F6"
                                             VerticalAlignment="Center"/>
                </Button>

                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,6"
                            MinWidth="165"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="LastCheckIcon"
                                                     Kind="Calendar"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="#3B82F6"
                                                     Margin="0,0,9,0"
                                                     VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Дата проверки"
                                           Foreground="#64748B"
                                           FontSize="12"/>
                                <TextBlock x:Name="TxtLastCheck"
                                           Text="—"
                                           Foreground="#3B82F6"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10,6"
                            MinWidth="210"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="20"
                                                     Height="20"
                                                     Foreground="#3B82F6"
                                                     Margin="0,0,9,0"
                                                     VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Разработчик"
                                           Foreground="#64748B"
                                           FontSize="12"/>
                                <TextBlock x:Name="TxtDesigner"
                                           Text="—"
                                           Foreground="#3B82F6"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtToggleColumns"
                                   Text="Доп. столбцы"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleColumns}"
                                                     Value="True">
                                            <Setter Property="Foreground" Value="#3B82F6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton x:Name="ToggleColumns"
                                      Style="{StaticResource SwitchToggleButtonStyle}"
                                      IsChecked="False"
                                      Click="ToggleColumns_Click"
                                      ToolTip="Показать или скрыть дополнительные столбцы"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= КАРТОЧКИ ================= -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">

            <UniformGrid Columns="6" Margin="0,0,593,0">

                <!-- Всего -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#3B82F6">
                                    <materialDesign:PackIcon Kind="LayersSearch"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Всего коллизий"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtAllClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbAll"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="100"
                                             Foreground="#3B82F6"/>

                                <TextBlock x:Name="TxtPercentAll"
                                           Grid.Column="1"
                                           Text="100%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Новые -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#64748B">
                                    <materialDesign:PackIcon Kind="NewBox"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Новые"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtNewClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbNew"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#64748B"/>

                                <TextBlock x:Name="TxtPercentNew"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Отправлено -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#F59E0B">
                                    <materialDesign:PackIcon Kind="SendCheck"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Отправлено"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtSendClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbSend"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#F59E0B"/>

                                <TextBlock x:Name="TxtPercentSend"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- В работе -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#3B82F6">
                                    <materialDesign:PackIcon Kind="Wrench"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="В работе"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtInWorkClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbInWork"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#3B82F6"/>

                                <TextBlock x:Name="TxtPercentInWork"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Согласовано -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#10B981">
                                    <materialDesign:PackIcon Kind="CheckCircle"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Согласовано"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtApproveClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbApprove"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#10B981"/>

                                <TextBlock x:Name="TxtPercentApprove"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Просрочено -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#EF4444">
                                    <materialDesign:PackIcon Kind="ClockAlert"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Просрочено"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtAllertClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbAllert"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#EF4444"/>

                                <TextBlock x:Name="TxtPercentAllert"
                                           Grid.Column="1"
                                           Text="0%"
                                           Foreground="#64748B"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>


            </UniformGrid>
        </Border>

        <!-- ================= ТАБЛИЦА ================= -->
        <DataGrid x:Name="DgClashes"
                  Grid.Row="2"
                  dgx:DataGridFilter.IsAutoFilterEnabled="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  FrozenColumnCount="2"
                  HeadersVisibility="Column"
                  RowHeight="30"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#6B7280"
                  Background="White"
                  BorderBrush="#E3E6EA"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEFF3"
                  VerticalGridLinesBrush="Transparent"
                  AlternatingRowBackground="#FBFBFC"
                  AlternationCount="2"
                  ColumnHeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                  SelectionChanged="DgClashes_SelectionChanged">

            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="#EFF6FF"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="#2F343B"/>

                <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2F343B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ApproveUser}" Value="{x:Null}">
                            <Setter Property="Background" Value="#F7F3E8"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Existing}" Value="False">
                            <Setter Property="Background" Value="#FEF2F2"/>
                            <Setter Property="Foreground" Value="#B91C1C"/>
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EFF6FF"/>
                            <Setter Property="Foreground" Value="#2F343B"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Найти в дереве элемент №1" Click="Search1_MouseRightButtonDown"/>
                    <MenuItem Header="Найти в дереве элемент №2" Click="Search2_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №1" Click="Add_Select1_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №2" Click="Add_Select2_MouseRightButtonDown"/>
                    <MenuItem Header="Пронумеровать выбранные" Click="NumbersOfSelectedClash"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Статус" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Border x:Name="StatusBorder"
                                    Padding="10,3"
                                    CornerRadius="10"
                                    Background="#F1F5F9">

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="StatusIcon"
                                                             Kind="CircleMedium"
                                                             Width="14"
                                                             Height="14"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center"
                                                             Foreground="#64748B"/>

                                    <TextBlock x:Name="StatusText"
                                               Text="{Binding Status}"
                                               VerticalAlignment="Center"
                                               Foreground="#64748B"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding StatusAge}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, ElementName=StatusText}"
                                               FontSize="10"
                                               Opacity="0.75">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                            </Border>

                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding Status}" Value="Новая">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#64748B"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CircleMedium"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#64748B"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Отправлено">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FFFBEB"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#F59E0B"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="SendCheck"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="В работе">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#EFF6FF"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#3B82F6"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="Wrench"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#3B82F6"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Согласовано">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#10B981"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircle"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#10B981"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Просрочен запрос">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#EF4444"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="ClockAlert"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#EF4444"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Просрочена работа">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#EF4444"/>
                                    <Setter TargetName="StatusIcon" Property="Kind" Value="ClockAlert"/>
                                    <Setter TargetName="StatusIcon" Property="Foreground" Value="#EF4444"/>
                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding Id}"
                                    Width="SizeToHeader"
                                    Foreground="#64748B"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ID" ToolTip="порядковый номер"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>


                <DataGridTextColumn x:Name = "GL"
                                    Binding="{Binding Building}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="GL" ToolTip="здание/сооружение"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "CT"
                                    Visibility="Collapsed"
                                    Binding="{Binding FirstElement}" 
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                        <DataGridTextColumn.Header>
                        <TextBlock Text="CT" ToolTip="тип коллизии"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    


                <DataGridTextColumn x:Name = "R1"
                                    Binding="{Binding FirstElement}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="SizeToHeader">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="R1" ToolTip="уникальный ключ 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "E1"
                                    Visibility="Collapsed"
                                    Binding="{Binding FirstType}"
                                    SortMemberPath="FirstUserMode"
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="E1 " ToolTip="тип 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
               
                <DataGridTextColumn x:Name = "U1"
                                    Binding="{Binding FirstUserMode}" 
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="U1" ToolTip="проектировщик 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "D1"
                                    Binding="{Binding FirstDept}" 
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="D1" ToolTip="подразделение 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "G1"
                                    Binding="{Binding FirstZone}"
                                    Width="SizeToHeader"
                                    HeaderStyle="{StaticResource GroupEndHeaderStyle}"
                                    CellStyle="{StaticResource GroupEndCellStyle}"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="G1" ToolTip="Зона первого элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "R2"
                                    Binding="{Binding SecondElement}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="SizeToHeader">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="R2" ToolTip="уникальный ключ 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                
                <DataGridTextColumn x:Name = "E2"
                                    Visibility="Collapsed"
                                   Binding="{Binding SecondType}"
                                   SortMemberPath="FirstUserMode"
                                   HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                   Width="SizeToHeader"
                                   ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="E1 " ToolTip="тип 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
              
                <DataGridTextColumn x:Name = "U2"
                                    Binding="{Binding SecondUserMode}" 
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="U2" ToolTip="проектировщик 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "D2"
                                    Binding="{Binding SecondDept}" 
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="D2" ToolTip="подразделение 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "G2"
                                    Binding="{Binding SecondZone}"
                                    Width="SizeToHeader"
                                    HeaderStyle="{StaticResource GroupEndHeaderStyle}"
                                    CellStyle="{StaticResource GroupEndCellStyle}"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="G2" ToolTip="Зона второго элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "XT"
                                    Binding="{Binding Existing}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="XT" ToolTip="наличие коллизии на момент проверки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                
                <DataGridTextColumn x:Name = "DT"
                                    Visibility="Collapsed"
                                    Binding="{Binding Date}"
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="DT" ToolTip="дата/время на момент проверки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
               
                <DataGridTextColumn x:Name = "X0"
                                    Visibility="Collapsed"
                                    Binding="{Binding x}"
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="X0" ToolTip="позиция X коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "Y0"
                                    Visibility="Collapsed"
                                    Binding="{Binding Y}" 
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Y0" ToolTip="позиция Y коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  x:Name = "Z0"
                                     Visibility="Collapsed"
                                    Binding="{Binding Z}" 
                                    HeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Z0" ToolTip="позиция Z коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                 
                <DataGridTextColumn x:Name = "RT"
                                    Binding="{Binding RequestToDept}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RT" ToolTip="запрос на согласование коллизии в отдел"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "RU"
                                    Binding="{Binding RequestUser}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RU" ToolTip="кто запрашивает согласование"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "RD"
                                    Binding="{Binding RequestDate}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RD" ToolTip="дата/время запроса на согласование"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  x:Name = "AU"
                                     Binding="{Binding ApproveUser}" 
                                     Width="Auto"
                                     ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AU" ToolTip="проектировщик, согласовавший коллизию"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  x:Name = "AD"
                                     Binding="{Binding ApproveDate}" 
                                     Width="Auto"
                                     ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AD" ToolTip="дата/время согласования коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name = "AR"
                                    Binding="{Binding ApproveReason}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AR" ToolTip="причина согласования коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  x:Name = "WU"
                                     Binding="{Binding InWorkUser}" 
                                     Width="Auto"
                                     ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="WU" ToolTip="проектировщик, взявший коллизию в работу"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name = "WD"
                                    Binding="{Binding InWorkDate}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="WD " ToolTip="дата/время взятия коллизии в работу"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>


        <!-- ================= НИЖНЯЯ ПАНЕЛЬ ================= -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,10,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                <Border x:Name="Indicator"
                        Width="18"
                        Height="18"
                        CornerRadius="4"
                        Background="#D1d5db"
                        BorderBrush="#BFC6CE"
                        BorderThickness="1"
                        Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtCheckStatus"
                           Text="Статус проверки не определён"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,0,16,0"/>
                <TextBlock x:Name="TxtSelectedCount"
                            Text="Выбрано: 0 коллизий"
                            VerticalAlignment="Center"
                            Foreground="#64748B"
                            FontSize="12"
                            Margin="0,0,10,0"/>
                <Button x:Name="BtnShowElements"
                         Style="{StaticResource PrimaryButtonStyle}"
                         IsEnabled="False"
                         Width="36"
                         MinWidth="36"
                         Padding="0"
                         ToolTip="Показать элементы"
                         Click="BtnShowElements_Click">
                    <materialDesign:PackIcon Kind="CubeOutline"
                                             Width="18"
                                             Height="18"
                                             Foreground="#3B82F6"
                                             VerticalAlignment="Center"/>
                </Button>
                </StackPanel>



                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="BtnCheck"
                            Style="{StaticResource PrimaryButtonStyle}"
                           
                            Click="BtnCheck_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll"
                                         Width="24"
                                         Height="24"
                                         Foreground="#3B82F6"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Проверить"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnApprove"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="BtnApprove_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagApprove"
                                                              Width="24"
                                                              Height="24"
                                                              Foreground="#3B82F6"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                            <TextBlock Text="Согласовать"
                                   VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTakeInWork"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="BtnTakeInWork_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TaskPlus"
                                          Width="24"
                                          Height="24"
                                          Foreground="#3B82F6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="Принять в работу "
               VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRequest"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Click="BtnRequest_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SendCircleOutline"
                           Width="24"
                           Height="24"
                           Foreground="#3B82F6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            <TextBlock Text="Отправить запрос "
                                        VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReject"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False"
                            Background="White"
                            BorderBrush="#DC2626"
                            Click="BtnReject_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#DC2626"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Отклонить"
                                       Foreground="#DC2626"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ApproveOverlay"
              Visibility="Collapsed"
              Background="#66000000"
              Grid.Row="0"
              Grid.RowSpan="4">
            <Border Width=" 420" Padding="20" CornerRadius="10" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Согласование коллизии"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Причина согласования допустимых коллизий"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbApproveReason"
                              Height="34"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Допустимая коллизия опорных конструкций с чистым полом"/>
                        <ComboBoxItem Content="Допустимая коллизия анкерного крепления опоры с ж/б конструкциями"/>
                        <ComboBoxItem Content="Длину тяг уточнить на монтаже"/>
                        <ComboBoxItem Content="Допустимая коллизия с резепвным объемом"/>
                        <ComboBoxItem Content="Проектное решение проходки через стену или перекрытие трубопроводом DN менее 100мм"/>
                        <ComboBoxItem Content="Касание по проекту"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BtnApproveCancel"
                                Width="90"
                                Margin="0,0,10,0"
                                Content="Отмена"
                                Click="BtnApproveCancel_Click"/>
                        <Button x:Name="BtnApproveOk"
                                Width="110"
                                Content="Согласовать"
                                Click="BtnApproveOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
        </Grid>


    </Grid>
</Window>



