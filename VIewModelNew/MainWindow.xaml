<Window x:Class="ViewForm.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Проверка на коллизии"
        Height="720"
        Width="1500"
        MinHeight="600"
        MinWidth="1200"
        Background="#F7F8FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Центровка текста в таблице -->
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Заголовки таблицы -->
        <Style x:Key="BaseColumnHeaderStyle" TargetType="DataGridColumnHeader">

            <Setter Property="Foreground" Value="#2F343B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- Прогрессбар карточек -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="#ECEFF3"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"/>

                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Синяя кнопка -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/>

            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Обычная нижняя кнопка -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="125"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>


            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= ВЕРХНЯЯ ПАНЕЛЬ ================= -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Margin="0,0,0,10">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Зона"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontSize="13"
                           FontWeight="SemiBold" Height="18"/>

                <!-- ComboBox с иконкой -->
                <Border
                        CornerRadius="8"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1" Grid.ColumnSpan="2" Margin="69,0,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                 Width="18"
                                                 Height="18"
                                                 
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                        <ComboBox x:Name="CbZone"
                                  Grid.Column="1"
                                  Height="34"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="ZoneElement"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Padding="0,4,8,4"
                                  FontWeight="SemiBold"
                                  Foreground="#111827"
                                  SelectionChanged="CbZone_SelectionChanged"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Обновить -->
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnRefresh_Click" Margin="10,0,17,0">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="RefreshCircle"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>

                        <TextBlock Text="Обновить"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================= КАРТОЧКИ ================= -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">

            <UniformGrid Columns="6" Margin="0,0,593,0">

                <!-- Всего -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#2F6FED">
                                    <materialDesign:PackIcon Kind="LayersSearch"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Всего"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtAllClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbAll"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="100"
                                             Foreground="#2F6FED"/>

                                <TextBlock x:Name="TxtPercentAll"
                                           Grid.Column="1"
                                           Text="100%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Новые -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#22C55E">
                                    <materialDesign:PackIcon Kind="NewBox"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Новые"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtNewClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbNew"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#22C55E"/>

                                <TextBlock x:Name="TxtPercentNew"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Отправлено -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#60A5FA">
                                    <materialDesign:PackIcon Kind="SendCheck"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Отправлено"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtSendClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbSend"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#60A5FA"/>

                                <TextBlock x:Name="TxtPercentSend"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- В работе -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#F59E0B">
                                    <materialDesign:PackIcon Kind="Wrench"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="В работе"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtInWorkClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbInWork"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#F59E0B"/>

                                <TextBlock x:Name="TxtPercentInWork"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Согласовано -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#10B981">
                                    <materialDesign:PackIcon Kind="CheckCircle"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Согласовано"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtApproveClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="2"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbApprove"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#10B981"/>

                                <TextBlock x:Name="TxtPercentApprove"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>

                <!-- Просрочено -->
                <Viewbox Stretch="Uniform" Width="130" Height="87" Margin="4">
                    <Border Width="150" Height="90" Padding="8" CornerRadius="8"
                            BorderBrush="#DDDDDD" BorderThickness="1" Background="White">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="12" Background="#EF4444">
                                    <materialDesign:PackIcon Kind="ClockAlert"
                                                             Width="24"
                                                             Height="24"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Просрочено"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top"
                                           Margin="5,2,0,0"/>
                            </Grid>

                            <TextBlock x:Name="TxtAllertClash"
                                       Text="0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Margin="0,24,23,0" Grid.RowSpan="3"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar x:Name="PbAllert"
                                             Style="{StaticResource ModernProgressBar}"
                                             Value="0"
                                             Foreground="#EF4444"/>

                                <TextBlock x:Name="TxtPercentAllert"
                                           Grid.Column="1"
                                           Text="0%"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>


            </UniformGrid>
        </Border>

        <!-- ================= ТАБЛИЦА ================= -->
        <DataGrid x:Name="DgClashes"
                  Grid.Row="2"
                  dgx:DataGridFilter.IsAutoFilterEnabled="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="30"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#6B7280"
                  Background="White"
                  BorderBrush="#E3E6EA"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#ECEFF3"
                  VerticalGridLinesBrush="Transparent"
                  AlternatingRowBackground="#FBFBFC"
                  AlternationCount="2"
                  ColumnHeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                  SelectionChanged="DgClashes_SelectionChanged">

            <DataGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2F343B"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F3F6FA"/>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#DCEBFA"/>
                            <Setter Property="Foreground" Value="#1F2937"/>
                        </Trigger>

                        <DataTrigger Binding="{Binding ApproveUser}" Value="{x:Null}">
                            <Setter Property="Background" Value="#F7F3E8"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Existing}" Value="False">
                            <Setter Property="Background" Value="#FFBD2828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Найти в дереве элемент №1" Click="Search1_MouseRightButtonDown"/>
                    <MenuItem Header="Найти в дереве элемент №2" Click="Search2_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №1" Click="Add_Select1_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №2" Click="Add_Select2_MouseRightButtonDown"/>
                    <MenuItem Header="Пронумеровать выбранные" Click="NumbersOfSelectedClash"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding Id}"
                                    Width="SizeToHeader"
                                    Foreground="#FFBD2828"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ID" ToolTip="порядковый номер"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Статус" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>

                            <Border x:Name="StatusBorder"
                    Padding="10,3"
                    CornerRadius="10">

                                <TextBlock x:Name="StatusText"
                           Text="{Binding Status}"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>

                            </Border>

                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding Status}" Value="Новая">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#DFF7E8"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#10B981"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Отправлено">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#DBEAFE"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#2563EB"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="В работе">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FEF3C7"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#D97706"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Согласовано">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#16A34A"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Запрос просрочен">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding Status}" Value="Работа просрочена">
                                    <Setter TargetName="StatusBorder" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTextColumn Binding="{Binding Building}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="GL" ToolTip="здание/сооружение"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--<DataGridTextColumn
                                    Binding="{Binding FirstElement}" 
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                        <DataGridTextColumn.Header>
                        <TextBlock Text="CT" ToolTip="тип коллизии"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    -->


                <DataGridTextColumn
                                    Binding="{Binding FirstElement}" 
                                    
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="SizeToHeader">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="R1" ToolTip="уникальный ключ 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!-- <DataGridTextColumn 
                                    Binding="{Binding FirstType}"
                                    SortMemberPath="FirstUserMode"
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="E1 " ToolTip="тип 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                -->
                <DataGridTextColumn 
                                    Binding="{Binding FirstUserMode}" 
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="U1" ToolTip="проектировщик 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding FirstDept}" 
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="D1" ToolTip="подразделение 1-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding FirstZone}"
                                   
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="G1" ToolTip="Зона первого элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn
                                   Binding="{Binding SecondElement}" 
                                   
                                   ElementStyle="{StaticResource CenterTextStyle}"
                                   Width="SizeToHeader">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="R1" ToolTip="уникальный ключ 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--
                <DataGridTextColumn 
                                   Binding="{Binding SecondType}"
                                   SortMemberPath="FirstUserMode"
                                   HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                   Width="SizeToHeader"
                                   ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="E1 " ToolTip="тип 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                -->
                <DataGridTextColumn 
                                    Binding="{Binding SecondUserMode}" 
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="U1" ToolTip="проектировщик 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding SecondDept}" 
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="D1" ToolTip="подразделение 2-го элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding SecondZone}"
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="G2" ToolTip="Зона второго элемента коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding Existing}"
                                    
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="XT" ToolTip="наличие коллизии на момент проверки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <!--
                <DataGridTextColumn 
                                    Binding="{Binding Date}"
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="DT" ToolTip="дата/время на момент проверки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
               
                <DataGridTextColumn 
                                    Binding="{Binding x}"
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="XO" ToolTip="позиция X коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding Y}" 
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="YO" ToolTip="позиция Y коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding Z}" 
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="ZO" ToolTip="позиция Z коллизии в координатах от нуля площадки"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                 -->
                <DataGridTextColumn
                                    Binding="{Binding RequestToDept}" 
                                    
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RT" ToolTip="запрос на согласование коллизии в отдел"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding RequestUser}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RU" ToolTip="кто запрашивает согласование"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                   Binding="{Binding RequestDate}" 
                                   Width="Auto"
                                   ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="RD" ToolTip="дата/время запроса на согласование"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                              Binding="{Binding ApproveUser}" 
                              Width="Auto"
                              ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AU" ToolTip="проектировщик, согласовавший коллизию"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  
                              Binding="{Binding ApproveDate}" 
                              Width="Auto"
                              ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AD" ToolTip="дата/время согласования коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  
                          Binding="{Binding ApproveReason}" 
                          Width="Auto"
                          ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="AR" ToolTip="причина согласования коллизии"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                          Binding="{Binding InWorkUser}" 
                          Width="Auto"
                          ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="WU" ToolTip="проектировщик, взявший коллизию в работу"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                        Binding="{Binding InWorkDate}" 
                        Width="Auto"
                        ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="WD " ToolTip="дата/время взятия коллизии в работу"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>


        <!-- ================= НИЖНЯЯ ПАНЕЛЬ ================= -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E3E6EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8"
                Margin="0,10,0,0">

            <DockPanel LastChildFill="False">
                <TextBlock x:Name="TbStatus"
                       DockPanel.Dock="Left"
                       Grid.Column="0"
                       Foreground="#6B7280"
                       FontSize="12"/>
                <TextBlock x:Name="TxtSelectedCount"
                           DockPanel.Dock="Left"
                           Text="Выбрано: 0 коллизий"
                           VerticalAlignment="Center"
                           Foreground="#374151"
                           FontSize="12"
                           Margin="16,0,10,0"/>
                <Button x:Name="BtnShowElements"
                        DockPanel.Dock="Left"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="BtnShowElements_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CubeOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Показать элементы"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border x:Name="Indicator"
                        Width="18"
                        Height="18"
                        CornerRadius="4"
                        Background="#D1d5db"
                        BorderBrush="#BFC6CE"
                        BorderThickness="1"
                        Margin="10"/>



                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="BtnCheck"
                            Style="{StaticResource PrimaryButtonStyle}"
                           
                            Click="BtnCheck_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll"
                                         Width="24"
                                         Height="24"
                                         Foreground="Black"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="Проверить"
                                       VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnApprove"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnApprove_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TagApprove"
                                                              Width="24"
                                                              Height="24"
                                                              Foreground="Black"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                            <TextBlock Text="Согласовать"
                                   VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnTakeInWork"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnTakeInWork_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TaskPlus"
                                          Width="24"
                                          Height="24"
                                          Foreground="Black"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            <TextBlock Text="Принять в работу "
               VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRequest"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnRequest_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SendCircleOutline"
                           Width="24"
                           Height="24"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                            <TextBlock Text="Отправить запрос "
                                        VerticalAlignment="Center"/>

                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnReject"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnReject_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#DC2626"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Отклонить"
                                       Foreground="#DC2626"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="ApproveOverlay"
              Visibility="Collapsed"
              Background="#66000000"
              Grid.Row="0"
              Grid.RowSpan="4">
            <Border Width=" 420" Padding="20" CornerRadius="10" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="Согласование коллизии"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Причина согласования допустимых коллизий"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbApproveReason"
                              Height="34"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Допустимая коллизия опорных конструкций с чистым полом"/>
                        <ComboBoxItem Content="Допустимая коллизия анкерного крепления опоры с ж/б конструкциями"/>
                        <ComboBoxItem Content="Длину тяг уточнить на монтаже"/>
                        <ComboBoxItem Content="Допустимая коллизия с резепвным объемом"/>
                        <ComboBoxItem Content="Проектное решение проходки через стену или перекрытие трубопроводом DN менее 100мм"/>
                        <ComboBoxItem Content="Касание по проекту"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="BtnApproveCancel"
                                Width="90"
                                Margin="0,0,10,0"
                                Content="Отмена"
                                Click="BtnApproveCancel_Click"/>
                        <Button x:Name="BtnApproveOk"
                                Width="110"
                                Content="Согласовать"
                                Click="BtnApproveOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
        </Grid>


    </Grid>
</Window>



