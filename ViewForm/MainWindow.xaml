<Window x:Class="ViewForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViewForm"
        mc:Ignorable="d"
        xmlns:dgx="urn:tom-englert.de/DataGridExtensions"
        Title="Проверка на коллизии" Height="720" Width="1500" MinHeight="600" MinWidth="1200" Background="#F7F8FA" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SoftSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}">

                            <Border x:Name="SwitchTrack"
                                CornerRadius="12"
                                Background="#E5E7EB"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"/>

                            <Border x:Name="SwitchThumb"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="White"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                Margin="2,0,0,0"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                    Property="Background"
                                    Value="#6FCF97"/>
                                <Setter TargetName="SwitchTrack"
                                    Property="BorderBrush"
                                    Value="#6FCF97"/>
                                <Setter TargetName="SwitchThumb"
                                    Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchThumb"
                                    Property="BorderBrush"
                                    Value="#BFC6CF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack"
                                    Property="Opacity"
                                    Value="0.55"/>
                                <Setter TargetName="SwitchThumb"
                                    Property="Opacity"
                                    Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="RoundedTextBlock" TargetType="Border">
            <Setter Property="Background" Value="#D6DAe1"/>
            <Setter Property="BorderBrush" Value="#D6DAe1"/>

            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="BaseColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#2F343B"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>


        <Style x:Key="HeaderGroup1Style" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource BaseColumnHeaderStyle}">
            <Setter Property="Background" Value="#F8FCF9"/>
            <Setter Property="Foreground" Value="#3F5F4B"/>

        </Style>

        <Style x:Key="HeaderGroup2Style" TargetType="DataGridColumnHeader"
       BasedOn="{StaticResource BaseColumnHeaderStyle}">
            <Setter Property="Background" Value="#FFFAFA"/>
            <Setter Property="Foreground" Value="#6F4a4A"/>
        </Style>
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


    </Window.Resources>


    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderThickness="2" Margin="0,0,0,8" BorderBrush="#E3E6EA" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="63"/>
                        <ColumnDefinition Width="Auto" MinWidth="7"/>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto" MinWidth="76"/>
                        <ColumnDefinition Width="155"/>

                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0" 
                               Height="21"
                               Text="Комплект :" 
                               FontSize="12"
                               Foreground="#6B7280"
                               FontWeight="SemiBold"/>
                    <Border Style="{StaticResource RoundedTextBlock}" Grid.Column="1" Margin="10,-1,49,4">
                        <ComboBox x:Name="CbGpset" 
                              Grid.Column="1" 
                              Height="32"
                              Padding="8,4"
                              FontWeight="SemiBold"
                              Foreground="#6FCF97"
                              SelectionChanged="CbGpset_SelectionChanged" 
                              BorderBrush="Transparent"
                              BorderThickness="0"
                              FontSize="13" VerticalAlignment="Top"/>
                    </Border>
                    <TextBlock Grid.Column="2" 
                               Text="Отдел :"
                               Margin="16,12,0,0" 
                               Height="27"
                               VerticalAlignment="Top" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               Foreground="#6B7280"/>
                    <Border Style="{StaticResource RoundedTextBlock}" Grid.Column="2" Margin="63,-1,0,4" Grid.ColumnSpan="4">

                        <TextBox x:Name="TbMyDept" 
                             Grid.Column="4" 
                             Height="32" 
                             TextChanged="TbMyDept_TextChanged" 
                             Padding="10,6,10,6" 
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"
                             Foreground="#6FCF97"
                             BorderThickness="0"
                             Background ="Transparent"/>
                    </Border>

                    <TextBlock VerticalAlignment="Center" 
                               Grid.Column="6" 
                               Margin="15,0,3,0" 
                               Text="Фамилия :" 
                               Height="20"
                               FontSize="12"
                               Foreground="#6B7280"
                               FontWeight="SemiBold"/>
                    <Border Style="{StaticResource RoundedTextBlock}" Grid.Column="7" Margin="9,0,10,3">
                        <TextBox x:Name="TbMyUlogId" 
                             Grid.Column="7" 
                             Height="31" 
                             TextChanged="TbMyUlogId_TextChanged"
                             Padding="10,6,10,6" 
                             VerticalAlignment="Center"  
                             FontWeight="SemiBold"
                             Foreground="#6FCF97"
                             BorderThickness="0"
                             Background ="Transparent" HorizontalAlignment="Center" Width="120"/>
                    </Border>

                    <TextBlock 
                        Grid.Column="8" 
                        VerticalAlignment="Center" 
                        Text="После" 
                        Height="16"
                        FontSize="12"
                        Foreground="#6B7280"
                        FontWeight="SemiBold" HorizontalAlignment="Left" RenderTransformOrigin="1.473,0.575" Margin="242,0,0,0" Width="35"/>
                    <DatePicker 
                        x:Name="DpFrom" 
                        Grid.Column="8" 
                        Height="24" 
                        Margin="137,0,98,0" 
                        VerticalAlignment="Center"/>

                    <TextBlock 
                        Grid.Column="8" 
                        VerticalAlignment="Center" 
                        Text="До" 
                        Height="16"
                        FontSize="12"
                        Foreground="#6B7280"
                        FontWeight="SemiBold" 
                        HorizontalAlignment="Left" 
                        Margin="116,0,0,0" Width="16"/>
                    <DatePicker
                        x:Name="DpTo"
                        Grid.Column="8"
                        Height="23"
                        Margin="280,0,-55,0"
                        VerticalAlignment="Center"/>
                </Grid>

                <WrapPanel Grid.Row="2"
           VerticalAlignment="Center"
           ItemHeight="28">

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Только моего отдела"
                                   FontWeight="SemiBold"
                                    Foreground="#6B7280"
                   Style="{StaticResource FilterTextStyle}"/>
                        <ToggleButton x:Name="ChOnlyMyDept"
                      Style="{StaticResource SoftSwitchStyle}"
                      Checked="ChOnlyMyDept_Checked"
                      Unchecked="ChOnlyMyDept_Checked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Прятать согласованные"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                   Style="{StaticResource FilterTextStyle}"/>
                        <ToggleButton x:Name="ChHideApproved"
                      Style="{StaticResource SoftSwitchStyle}"
                      Checked="ChHideApproved_Checked"
                      Unchecked="ChHideApproved_Checked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Прятать чужие в работе"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                   Style="{StaticResource FilterTextStyle}"/>
                        <ToggleButton x:Name="ChHideOthersInWork"
                      Style="{StaticResource SoftSwitchStyle}"
                      Checked="ChHideOthersInWork_Checked"
                      Unchecked="ChHideOthersInWork_Checked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <TextBlock Text="Только с запросом к моему отделу"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                   Style="{StaticResource FilterTextStyle}"/>
                        <ToggleButton x:Name="ChOnlyRequestToMyDept"
                      Style="{StaticResource SoftSwitchStyle}"
                      Checked="ChOnlyRequestToMyDept_Checked"
                      Unchecked="ChOnlyRequestToMyDept_Checked"/>
                    </StackPanel>

                </WrapPanel>

            </Grid>
        </Border>


        <DataGrid x:Name="DgClashes"
                  dgx:DataGridFilter.IsAutoFilterEnabled="true"
                  Grid.Row="1"
                  ColumnHeaderStyle="{StaticResource BaseColumnHeaderStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeight="30"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Foreground="#6B7280"
                  Background="White"
                  BorderBrush="#e3e6ea"
                  BorderThickness="1"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#eceff3"
                  VerticalGridLinesBrush="Transparent"
                  AlternatingRowBackground="#fbfbfc"
                  AlternationCount="2"
                  SelectionChanged="DgClashes_SelectionChanged">

            <DataGrid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="TextAlignment"
                            Value="Center"/>
                    <Setter Property="HorizontalAlignment"
                            Value="Center"/>
                    <Setter Property="VerticalAlignment"
                            Value="Center"/>
                </Style>
            </DataGrid.Resources>


            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2f343b"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#f3f6fa"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#DCEBFA"/>
                            <Setter Property="Foreground" Value="#1f2937"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding ApproveUser}" Value="{x:Null}">
                            <Setter Property="Background" Value="#F7F3E8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Existing}" Value="False">
                            <Setter Property="Background" Value="#FFBD2828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Найти в дереве элемент №1"
                              Click="Search1_MouseRightButtonDown"/>
                    <MenuItem Header="Найти в дереве элемент №2"
                              Click="Search2_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №1"
                              Click="Add_Select1_MouseRightButtonDown"/>
                    <MenuItem Header="Добавить и подсветить в 3D элемент №2"
                              Click="Add_Select2_MouseRightButtonDown"/>
                    <MenuItem Header="Пронумеровать выбранные"
                              Click="NumbersOfSelectedClash"/>


                </ContextMenu>

            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn 
                                    Binding="{Binding Id}" 
                                    Width="SizeToHeader" 
                                    FontWeight="SemiBold" 
                                    Foreground="#FFBD2828"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="№" ToolTip="id"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  
                                    Binding="{Binding ClashType}" 
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Коллизия" ToolTip="type" />
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn
                                    Binding="{Binding FirstElement}" 
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Элемент 1" ToolTip="El1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>


                <DataGridTextColumn
                                    Binding="{Binding FirstType}" 
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="SizeToHeader">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Тип 1" ToolTip="type1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn 
                                    Binding="{Binding FirstUserMode}"
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Польз. 1" ToolTip="usermode1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn 
                                    Binding="{Binding Flnm1}" 
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToCells"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Имя 1" ToolTip="flnm1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding FirstDept}" 
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Отд. 1" ToolTip="dept1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding FirstGpset}"
                                    HeaderStyle="{StaticResource  HeaderGroup1Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Компл. 1" ToolTip="gpset1"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding SecondElement}"
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="SizeToHeader"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Элемент 2" ToolTip="El2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn 
                                    Binding="{Binding SecondType}"
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Тип 2" ToolTip="type2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn 
                                    Binding="{Binding SecondUserMode}"
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Польз. 2" ToolTip="usermod2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding Flnm2}" 
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Имя 2" ToolTip="flnm2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding SecondDept}" 
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Отд. 2" ToolTip="dept2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn
                                    Binding="{Binding SecondGpset}" 
                                    HeaderStyle="{StaticResource  HeaderGroup2Style}"
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Компл. 2" ToolTip="gpset2"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn  
                                    Binding="{Binding Date}" 
                                    Width="Auto"
                                    ElementStyle="{StaticResource CenterTextStyle}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="Дата" ToolTip="date"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Header="X" 
                                    Binding="{Binding X}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="Y" 
                                    Binding="{Binding Y}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="Z" 
                                    Binding="{Binding Z}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="Existing" 
                                    Binding="{Binding Existing}"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="RequestToDept" 
                                    Binding="{Binding RequestToDept}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="RequestUser" 
                                    Binding="{Binding RequestUser}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="RequestDate" 
                                    Binding="{Binding RequestDate}"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="ApproveUser" 
                                    Binding="{Binding ApproveUser}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="ApproveDate" 
                                    Binding="{Binding ApproveDate}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="ApproveReason" 
                                    Binding="{Binding ApproveReason}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="InWorkUser" 
                                    Binding="{Binding InWorkUser}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
                <DataGridTextColumn Header="InWorkDate" 
                                    Binding="{Binding InWorkDate}" 
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
            Background="White"
                BorderBrush="#e3e6ea"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8" Margin="0,21,0,0">



            <DockPanel LastChildFill="False">

                <TextBlock x:Name="TbStatus"
                       DockPanel.Dock="Left"
                       Grid.Column="0"
                       Foreground="#6B7280"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="Всего коллизий = 0"/>
                <Border x:Name="Indicator"
        Width="18"
        Height="18"
        CornerRadius="4"
        Background="#D1d5db"
        BorderBrush="#BFC6CE"
        BorderThickness="1"
        Margin="10"/>
                <StackPanel DockPanel.Dock="Right"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

                    <Button x:Name="BtnCheck"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Background="#dcebfa"
                    BorderBrush="#c6ddf7"
                    BorderThickness="0"
                    Foreground="#1f2937"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Width="120"
                    Height="30"
                    Content="Проверить"
                    Click="BtnCheck_Click"/>

                    <Button x:Name="BtnApprove"
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    Background="#f3f4f6"
                    BorderBrush="#d8dce3"
                    Foreground="#374151"
                    Cursor="Hand"
                    Width="120"
                    Height="30"
                    Content="Согласовать"
                    Click="BtnApprove_Click"/>

                    <Button x:Name="BtnTakeInWork"
                    Grid.Column="5"
                    Width="120"
                    Height="30"
                    Background="#f3f4f6"
                    Cursor="Hand"
                    BorderBrush="#d8dce3"
                    Margin="0,0,8,0"
                    Foreground="#374151"
                    Content="Принять в работу"
                    Click="BtnTakeInWork_Click"/>

                    <Button x:Name="BtnRequest"
                    Grid.Column="7"
                    Width="120"
                    Height="30"
                    Background="#f3f4f6"
                    Cursor="Hand"
                    BorderBrush="#d8dce3"
                    Margin="0,0,8,0"
                    Foreground="#374151"
                    Content="Отправить запрос"
                    Click="BtnRequest_Click"/>

                    <Button x:Name="BtnClose"
        Width="90"
        Height="30"
        Cursor="Hand"
        Click="BtnClose_Click"
        Background="#f8edee"
        BorderBrush="#e8d3d6"
        Margin="0,0,8,0">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">

                                <Border x:Name="border"
                    CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">

                                    <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
                                </Border>

                                <ControlTemplate.Triggers>

                                    <!-- Hover -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                            Property="Background"
                            Value="#f2dfe1"/>
                                    </Trigger>

                                    <!-- Нажатие -->
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                            Property="Background"
                            Value="#e9cfd3"/>
                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Button.Template>

                        <TextBlock Text="Сдать"
               Foreground="#6b3e46"
               FontWeight="SemiBold"/>

                    </Button>


                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</Window>


